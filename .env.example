# Скопируйте в .env и заполните локально. .env нельзя отправлять в архив.
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_SESSION_ID=kumar-panel
# 0 = Ollama и смысловые embeddings отключены, поиск работает по словам.
KUMAR_SEMANTIC_SEARCH=0
# Токен оператора для изменяющих эндпоинтов панели (заметки, эмоция, backstage,
# backup, настройки движка, сброс сессии). Пусто — проверка отключена
# (допустимо только для localhost). В LAN-режиме (MIRA_LAN=1) задавать обязательно.
KUMAR_ADMIN_TOKEN=
